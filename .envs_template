# Infosystem 部署环境依赖模板
# 复制为仓库根目录 .envs 后，按要使用的功能填写。可选功能缺配置时单独停用。
# .envs 只留本机。已设置的进程环境变量优先。空端口使用协议默认值。

# 本地模型｜3 项，留空时使用项目 .models 下的约定目录
BGE_MODEL=
ASR_MODEL_ROOT=
RERANK_MODEL_DIR=

# 外部服务一：Marker 远端脚本｜SSH 主机、端口、用户和 2 选 1 的认证；另需 Python、脚本、输入、输出、日志 5 项，激活命令可选
SSH_HOST=
SSH_PORT=
SSH_USERNAME=
SSH_KEY_PATH=
SSH_PASSWORD=
REMOTE_PYTHON=
REMOTE_CONVERT_SCRIPT=
REMOTE_INPUT_DIR=
REMOTE_OUTPUT_DIR=
REMOTE_LOG_DIR=
REMOTE_ACTIVATE=

# 同一远端主机上的可选任务｜使用时自备脚本。MinerU 4 项、翻译 2 项、清理脚本与辅助目录 3 项
REMOTE_MINERU_SCRIPT=
REMOTE_MINERU_INPUT_DIR=
REMOTE_MINERU_OUTPUT_DIR=
REMOTE_MINERU_LOG_DIR=
REMOTE_TRANSLATE_SCRIPT=
REMOTE_TRANSLATE_DIR=
REMOTE_OLLAMA_CLEANUP_SCRIPT=
REMOTE_SCRIPT_PATH=
REMOTE_TARGET_DIR=

# 外部服务二：校园网络出口｜SOCKS 地址 2 项（供显式浏览器路由和 SSH/FTP 回退）、类型 1 项、校园出口识别前缀 1 项；通用 HTTP 代理另 1 项
SSH_PROXY_HOST=
SSH_PROXY_PORT=
SSH_PROXY_TYPE=
CAMPUS_IP_PREFIXES=
PAPER_HTTP_PROXY_URL=

# 机构图书馆适配｜代理源、协议参数、票据名、授权会话路径 4 项；机构显示名探测另 1 项
ELIB_PROXY_ORIGIN=
ELIB_KEY_HEX=
ELIB_TICKET_COOKIE=
ELIB_SESSION_PATH=
CNKI_INSTITUTION_NAME=

# 可选远程文件服务（自备）｜FTP 4 项、HTTP 下载地址 1 项、服务端环境 2 项
REMOTE_FS_FTP_HOST=
REMOTE_FS_FTP_PORT=
REMOTE_FS_FTP_USER=
REMOTE_FS_FTP_PASS=
REMOTE_FS_HTTP_URL=
REMOTE_FS_ALLOWED_BASE=
REMOTE_FS_TMP_DIR=

# 可选应用 API 和平台｜按功能填写模型密钥或站点登录态；QQ 拦截名单逗号分隔，可留空
GLM_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
PADDLEOCR_API_KEY=
BILI_COOKIE=
BILI_COOKIE_SESSDATA=
BILI_COOKIE_BILI_JCT=
BILI_COOKIE_DEDEUSERID=
STAGING_PRIVATE_IDS=

# 可选贴吧凭据 3 项，及本机输出根目录 1 项
BDUSS=
BAIDUID=
STOKEN=
OUTPUT_ROOT=
